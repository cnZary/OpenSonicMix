<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    混音台语义资源，复用 .NET 内置 PresentationFramework.Fluent 的颜色与控件模板。
    Fluent 2: https://fluent2.microsoft.design/design-tokens 、/layout 、/typography
    中性表面形成层级；强调色跟随系统，仅用于选中态和交互；4px 控件 / 8px 卡片圆角。
    音频电平与警告色独立保留语义，避免将系统强调色误当作电平状态。
  -->

  <!-- 字体族 -->
  <FontFamily x:Key="FontPrimary">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Bahnschrift, Consolas, Segoe UI</FontFamily>
  <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Fluent 2 暗色层级色彩 (Base / Layer / Card / Control) -->
  <Color x:Key="ColorWindow">#FF202020</Color>
  <Color x:Key="ColorPanel">#FF282828</Color>
  <Color x:Key="ColorPanelAlt">#FF2C2C2C</Color>
  <Color x:Key="ColorPanelDeep">#FF1C1C1C</Color>
  <Color x:Key="ColorCardHeader">#FF323232</Color>
  <Color x:Key="ColorBorder">#FF383838</Color>
  <Color x:Key="ColorBorderLight">#FF606060</Color>
  <Color x:Key="ColorDivider">#18FFFFFF</Color>
  <Color x:Key="ColorControl">#FF323238</Color>
  <Color x:Key="ColorControlHover">#FF3C3C43</Color>
  <Color x:Key="ColorControlPressed">#FF29292E</Color>

  <!-- Fluent 2 文本层级 (#FFFFFF / #C5FFFFFF / #87FFFFFF / #5DFFFFFF) -->
  <Color x:Key="ColorText">#FFFFFFFF</Color>
  <Color x:Key="ColorTextSecondary">#C8FFFFFF</Color>
  <Color x:Key="ColorTextTertiary">#8AFFFFFF</Color>
  <Color x:Key="ColorTextDisabled">#5DFFFFFF</Color>

  <!-- Fluent 2 状态与语义色 (Windows 11 Dark Accent & System Fill Colors) -->
  <Color x:Key="ColorAccent">#FF4CC2FF</Color>
  <Color x:Key="ColorAccentHover">#FF68CCFF</Color>
  <Color x:Key="ColorAccentPressed">#FF38AEEB</Color>
  <Color x:Key="ColorAccentSubtle">#264CC2FF</Color>
  <Color x:Key="ColorOn">#FF6CCB5F</Color>
  <Color x:Key="ColorOff">#FF484850</Color>
  <Color x:Key="ColorWarn">#FFFCE100</Color>
  <Color x:Key="ColorAmber">#FFFFB900</Color>
  <Color x:Key="ColorError">#FFFF99A4</Color>
  <Color x:Key="ColorDangerFill">#FFE84856</Color>
  <Color x:Key="ColorDangerHover">#FFF25C69</Color>

  <!-- 电平表槽背景与三段音频色 -->
  <Color x:Key="ColorMeterTrack">#FF161616</Color>
  <Color x:Key="ColorMeterGreen">#FF45D16E</Color>
  <Color x:Key="ColorMeterYellow">#FFF7C83E</Color>
  <Color x:Key="ColorMeterRed">#FFF25252</Color>

  <!-- 自绘控件辅助色 (刻度/轨道/帽/高光) -->
  <Color x:Key="ColorTickMajor">#FF8A8A8A</Color>
  <Color x:Key="ColorFaderTrack">#FF161616</Color>
  <Color x:Key="ColorThumbTop">#FF505050</Color>
  <Color x:Key="ColorThumbBottom">#FF444444</Color>
  <Color x:Key="ColorThumbBorder">#FF707070</Color>
  <Color x:Key="ColorThumbLine">#FFFFFFFF</Color>

  <!-- 基础 SolidColorBrush -->
  <SolidColorBrush x:Key="BrushWindow" Color="{DynamicResource SolidBackgroundFillColorBase}"/>
  <SolidColorBrush x:Key="BrushPanel" Color="{DynamicResource SolidBackgroundFillColorTertiary}"/>
  <SolidColorBrush x:Key="BrushPanelAlt" Color="{DynamicResource SolidBackgroundFillColorQuarternary}"/>
  <SolidColorBrush x:Key="BrushPanelDeep" Color="{DynamicResource SolidBackgroundFillColorSecondary}"/>
  <SolidColorBrush x:Key="BrushCardHeader" Color="{StaticResource ColorCardHeader}"/>
  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
  <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}"/>
  <SolidColorBrush x:Key="BrushDivider" Color="{DynamicResource DividerStrokeColorDefault}"/>
  <SolidColorBrush x:Key="BrushControl" Color="{DynamicResource ControlFillColorDefault}"/>
  <SolidColorBrush x:Key="BrushControlHover" Color="{DynamicResource ControlFillColorSecondary}"/>
  <SolidColorBrush x:Key="BrushControlPressed" Color="{DynamicResource ControlFillColorTertiary}"/>
  <SolidColorBrush x:Key="BrushText" Color="{DynamicResource TextFillColorPrimary}"/>
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{DynamicResource TextFillColorSecondary}"/>
  <SolidColorBrush x:Key="BrushTextTertiary" Color="{DynamicResource TextFillColorTertiary}"/>
  <SolidColorBrush x:Key="BrushTextDisabled" Color="{DynamicResource TextFillColorDisabled}"/>
  <SolidColorBrush x:Key="BrushAccent" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}"/>
  <SolidColorBrush x:Key="BrushAccentHover" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" Opacity="0.9"/>
  <SolidColorBrush x:Key="BrushAccentPressed" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" Opacity="0.8"/>
  <SolidColorBrush x:Key="BrushAccentSubtle" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" Opacity="0.12"/>
  <SolidColorBrush x:Key="BrushOn" Color="{StaticResource ColorOn}"/>
  <SolidColorBrush x:Key="BrushOff" Color="{StaticResource ColorOff}"/>
  <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource ColorWarn}"/>
  <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
  <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>
  <SolidColorBrush x:Key="BrushDangerFill" Color="{StaticResource ColorDangerFill}"/>
  <SolidColorBrush x:Key="BrushDangerHover" Color="{StaticResource ColorDangerHover}"/>
  <SolidColorBrush x:Key="BrushMeterTrack" Color="{StaticResource ColorMeterTrack}"/>
  <SolidColorBrush x:Key="BrushTickMajor" Color="{StaticResource ColorTickMajor}"/>
  <SolidColorBrush x:Key="BrushFaderTrack" Color="{StaticResource ColorFaderTrack}"/>
  <SolidColorBrush x:Key="BrushThumbLine" Color="{StaticResource ColorThumbLine}"/>

  <!-- Windows Fluent 用细描边表达卡片层级，避免大面积装饰渐变。 -->
  <SolidColorBrush x:Key="BrushCardElevationBorder" Color="{DynamicResource CardStrokeColorDefault}"/>
  <SolidColorBrush x:Key="BrushCardSurface" Color="{DynamicResource SolidBackgroundFillColorTertiary}"/>

  <LinearGradientBrush x:Key="BrushControlElevation" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
    <GradientStop Offset="0.33" Color="#26FFFFFF"/>
    <GradientStop Offset="1.0" Color="#14FFFFFF"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushAccentElevation" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
    <LinearGradientBrush.RelativeTransform>
      <ScaleTransform ScaleY="-1" CenterY="0.5"/>
    </LinearGradientBrush.RelativeTransform>
    <GradientStop Offset="0.33" Color="#28000000"/>
    <GradientStop Offset="1.0" Color="#18FFFFFF"/>
  </LinearGradientBrush>

  <!-- 尺寸 / 圆角 / 间距 (Fluent 2 Geometry: Control=4px, Card/Overlay=8px) -->
  <sys:Double x:Key="RadiusSmall">3</sys:Double>
  <sys:Double x:Key="RadiusMedium">4</sys:Double>
  <sys:Double x:Key="RadiusLarge">8</sys:Double>
  <sys:Double x:Key="ControlHeight">28</sys:Double>
  <sys:Double x:Key="SpacingXs">2</sys:Double>
  <sys:Double x:Key="SpacingS">4</sys:Double>
  <sys:Double x:Key="SpacingM">8</sys:Double>
  <sys:Double x:Key="SpacingL">12</sys:Double>

  <!-- 文字尺寸 -->
  <sys:Double x:Key="FontSizeLabel">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeTitle">14</sys:Double>

  <!-- 通道卡片 -->
  <Style x:Key="ChannelCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushCardSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushCardElevationBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 嵌入式深色槽容器(如电平表外框、参数旋钮盘、图形 EQ 背板) -->
  <Style x:Key="InsetWellBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushPanelDeep}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushDivider}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 数值读数胶囊 (推子底部 dB 读数、EQ 增益读数) -->
  <Style x:Key="ReadoutPill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushPanelDeep}"/>
    <Setter Property="BorderBrush" Value="#18FFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 通道条顶部标题徽章 -->
  <Style x:Key="ChannelHeaderBadge" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="0,4"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 通道功能开关(COMP/EQ/HPF/INST/LOOPBACK 等标准 Accent 激活样式) -->
  <Style x:Key="ChannelToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{StaticResource BrushControl}"
                  BorderBrush="{StaticResource BrushControlElevation}" BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,0">
            <Grid>
              <!-- 左侧或底部微状态指示条 -->
              <Rectangle x:Name="ind" Width="12" Height="2" RadiusX="1" RadiusY="1"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Fill="{StaticResource BrushTextTertiary}" Opacity="0.35"/>
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlHover}"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.65"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlPressed}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccent}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccentElevation}"/>
              <Setter TargetName="ind" Property="Fill" Value="#FF0A0A0D"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.65"/>
              <Setter Property="Foreground" Value="#FF0A0A0D"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushPanelDeep}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
              <Setter TargetName="ind" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 警告/琥珀色硬件开关 (48V 幻象电源、SOLO 独听) -->
  <Style x:Key="WarnToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChannelToggle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{StaticResource BrushControl}"
                  BorderBrush="{StaticResource BrushControlElevation}" BorderThickness="1"
                  CornerRadius="4" Padding="6,0">
            <Grid>
              <Rectangle x:Name="ind" Width="12" Height="2" RadiusX="1" RadiusY="1"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Fill="{StaticResource BrushAmber}" Opacity="0.45"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlHover}"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlPressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAmber}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccentElevation}"/>
              <Setter TargetName="ind" Property="Fill" Value="#FF141004"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.7"/>
              <Setter Property="Foreground" Value="#FF141004"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushPanelDeep}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
              <Setter TargetName="ind" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 危险/静音开关 (MUTE / MASTER MUTE / ON AIR 红色高亮) -->
  <Style x:Key="MuteToggle" TargetType="ToggleButton" BasedOn="{StaticResource ChannelToggle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{StaticResource BrushControl}"
                  BorderBrush="{StaticResource BrushControlElevation}" BorderThickness="1"
                  CornerRadius="4" Padding="6,0">
            <Grid>
              <Rectangle x:Name="ind" Width="12" Height="2" RadiusX="1" RadiusY="1"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Fill="{StaticResource BrushError}" Opacity="0.45"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlHover}"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControlPressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushDangerFill}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccentElevation}"/>
              <Setter TargetName="ind" Property="Fill" Value="#FFFFFFFF"/>
              <Setter TargetName="ind" Property="Opacity" Value="0.85"/>
              <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushDangerHover}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushPanelDeep}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
              <Setter TargetName="ind" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 效果模块导航按钮(左侧竖排 COMP/EQ/HPF 选择,带 Fluent 2 左侧 Selection Pill) -->
  <Style x:Key="NavModuleToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="5" Padding="10,0">
            <Grid>
              <Rectangle x:Name="pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                         Fill="{StaticResource BrushAccent}" Visibility="Collapsed"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushControl}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushControlElevation}"/>
              <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 设置窗紧凑 GroupBox(Fluent 2 Settings Card 风格) -->
  <Style x:Key="CompactGroup" TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{StaticResource BrushCardSurface}"
                  BorderBrush="{StaticResource BrushCardElevationBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="12,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                  TextElement.FontFamily="{StaticResource FontDisplay}"
                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="14"
                                  TextElement.Foreground="{StaticResource BrushText}"/>
              </StackPanel>
              <ContentPresenter/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 标准控件直接继承 WPF 内置 Fluent 模板，保留原生键盘导航与交互状态。 -->
  <Style x:Key="PlainCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
  </Style>

  <Style x:Key="PlainRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
  </Style>

  <!-- 次要操作按钮(重置/菜单/设置):Fluent 2 Standard Button -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>

  <!-- 强调主按钮(设置窗 OK 等) -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>

  <!-- 危险确认按钮(重置整台设备) -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="#1AE84856"
                  BorderBrush="#38FF99A4" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#30E84856"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#55FF99A4"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#45E84856"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
              <Setter TargetName="b" Property="Background" Value="{StaticResource BrushPanelDeep}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 模块页签(效果编辑区顶部 Pivot / Segmented Tab) -->
  <Style x:Key="ModuleTab" TargetType="ToggleButton">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="Transparent" CornerRadius="5"
                  Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
              <Rectangle x:Name="pill" Height="3" Width="20" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Fill="{StaticResource BrushAccent}" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#10FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
              <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 标签/数值/标题文本 -->
  <Style x:Key="LabelText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SectionCaptionText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <!-- 下拉框与弹出项使用内置 Fluent 模板。 -->
  <Style x:Key="MixerCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="10,0,28,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ToolTip" Value="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
  </Style>

  <Style x:Key="MixerComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
    <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
</ResourceDictionary>

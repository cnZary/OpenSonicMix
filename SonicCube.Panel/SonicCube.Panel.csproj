<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SonicCube.Panel</RootNamespace>
    <!-- 框架依赖单文件,win-x64,不裁剪,不 NativeAOT(见需求 10.1/17.2)-->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonicCube.Protocol\SonicCube.Protocol.csproj" />
    <ProjectReference Include="..\SonicCube.Shared\SonicCube.Shared.csproj" />
  </ItemGroup>

</Project>

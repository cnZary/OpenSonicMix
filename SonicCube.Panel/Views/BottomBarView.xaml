<UserControl x:Class="SonicCube.Panel.Views.BottomBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource ChannelCard}" Padding="10,6">
    <Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <!-- Fluent 2 状态胶囊(含状态呼吸灯) -->
        <Border Background="{StaticResource BrushPanelDeep}" BorderBrush="#18FFFFFF"
                BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource BrushOn}"
                     VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource LabelText}"
                       Foreground="{StaticResource BrushText}" FontWeight="Medium" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ToggleButton x:Name="BtnEfx" Style="{StaticResource ChannelToggle}" Width="72" Margin="0,0,6,0"/>
        <ToggleButton x:Name="BtnMonitor" Style="{StaticResource ChannelToggle}" Width="86" Margin="0,0,6,0"/>
        <ToggleButton x:Name="BtnOnAir" Style="{StaticResource MuteToggle}" Width="76" Margin="0,0,6,0"/>
      </StackPanel>
      <Button x:Name="MenuBtn" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
              Padding="14,0" VerticalAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>

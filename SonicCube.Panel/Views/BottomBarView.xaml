<UserControl x:Class="SonicCube.Panel.Views.BottomBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource ChannelCard}" Padding="12,8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="0,0,16,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource BrushOn}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource LabelText}"
                       TextAlignment="Left" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
          </Grid>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton x:Name="BtnEfx" Style="{StaticResource ChannelToggle}" Width="72" Margin="0,0,8,0"/>
        <ToggleButton x:Name="BtnMonitor" Style="{StaticResource ChannelToggle}" Width="88" Margin="0,0,8,0"/>
        <ToggleButton x:Name="BtnOnAir" Style="{StaticResource MuteToggle}" Width="80"/>
      </StackPanel>
      <Button x:Name="MenuBtn" Grid.Column="2" Style="{StaticResource SubtleButton}"
              Padding="12,0" Margin="16,0,0,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="SettingsLabel" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>

<Window x:Class="SonicCube.Panel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" SizeToContent="Height"
        Background="{StaticResource BrushWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" VerticalAlignment="Top">
      <GroupBox x:Name="GGeneral" Header="General" Style="{StaticResource CompactGroup}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LLanguage" Style="{StaticResource LabelText}" TextAlignment="Left" VerticalAlignment="Center"/>
            <ComboBox x:Name="Lang" Grid.Column="1" Height="26" Style="{StaticResource MixerCombo}" ItemContainerStyle="{StaticResource MixerComboItem}"/>
          </Grid>
          <CheckBox x:Name="StartWithWindows" Style="{StaticResource PlainCheck}" Margin="0,8,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GConn" Header="Connection" Style="{StaticResource CompactGroup}">
        <StackPanel>
          <TextBlock x:Name="LMidiWorkMode" Style="{StaticResource LabelText}" TextAlignment="Left"/>
          <RadioButton x:Name="ModeLow" Style="{StaticResource PlainRadio}" Margin="0,4,0,0" GroupName="mode"/>
          <RadioButton x:Name="ModeFast" Style="{StaticResource PlainRadio}" Margin="0,2,0,0" GroupName="mode"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GStartup" Header="Startup Behavior" Style="{StaticResource CompactGroup}">
        <StackPanel>
          <CheckBox x:Name="Enable48V" Style="{StaticResource PlainCheck}"/>
          <CheckBox x:Name="EnableEFX" Style="{StaticResource PlainCheck}" Margin="0,2,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GReconnect" Header="Device Reconnection" Style="{StaticResource CompactGroup}">
        <StackPanel>
          <CheckBox x:Name="Reapply" Style="{StaticResource PlainCheck}"/>
          <TextBlock x:Name="ReapplyHint" Style="{StaticResource LabelText}" TextAlignment="Left" Margin="24,2,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GOther" Header="Other" Style="{StaticResource CompactGroup}">
        <StackPanel>
          <CheckBox x:Name="AlwaysOnTop" Style="{StaticResource PlainCheck}"/>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LLogDir" Style="{StaticResource LabelText}" TextAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="OpenLog" Grid.Column="1" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left"/>
          </Grid>
        </StackPanel>
      </GroupBox>
    </StackPanel>

    <Button x:Name="CloseBtn" Grid.Row="1" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Width="90" Content="OK"/>
  </Grid>
</Window>

<Window x:Class="SonicCube.Panel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" MaxHeight="760"
        Background="{StaticResource BrushWindow}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="SettingsHeading" Grid.Row="0" FontFamily="{StaticResource FontDisplay}"
               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,20"/>

    <ScrollViewer Grid.Row="1" MaxHeight="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel VerticalAlignment="Top">
      <GroupBox x:Name="GGeneral" Header="General" Style="{StaticResource CompactGroup}" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LLanguage" Style="{StaticResource LabelText}" TextAlignment="Left" VerticalAlignment="Center"/>
            <ComboBox x:Name="Lang" Grid.Column="1" Height="28" Style="{StaticResource MixerCombo}" ItemContainerStyle="{StaticResource MixerComboItem}"/>
          </Grid>
          <CheckBox x:Name="StartWithWindows" Style="{StaticResource PlainCheck}" Margin="0,12,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GConn" Header="Connection" Style="{StaticResource CompactGroup}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="LMidiWorkMode" Style="{StaticResource LabelText}" TextAlignment="Left" Margin="0,0,0,4"/>
          <RadioButton x:Name="ModeLow" Style="{StaticResource PlainRadio}" Margin="0,4,0,0" GroupName="mode"/>
          <RadioButton x:Name="ModeFast" Style="{StaticResource PlainRadio}" Margin="0,8,0,0" GroupName="mode"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GStartup" Header="Startup Behavior" Style="{StaticResource CompactGroup}" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox x:Name="Enable48V" Style="{StaticResource PlainCheck}"/>
          <CheckBox x:Name="EnableEFX" Style="{StaticResource PlainCheck}" Margin="0,8,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GReconnect" Header="Device Reconnection" Style="{StaticResource CompactGroup}" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox x:Name="Reapply" Style="{StaticResource PlainCheck}"/>
          <TextBlock x:Name="ReapplyHint" Style="{StaticResource LabelText}" Foreground="{StaticResource BrushTextTertiary}"
                     TextAlignment="Left" TextWrapping="Wrap" Margin="28,4,0,0"/>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="GOther" Header="Other" Style="{StaticResource CompactGroup}" Margin="0">
        <StackPanel>
          <CheckBox x:Name="AlwaysOnTop" Style="{StaticResource PlainCheck}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LLogDir" Style="{StaticResource LabelText}" TextAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="OpenLog" Grid.Column="1" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" MinWidth="80"/>
          </Grid>
        </StackPanel>
      </GroupBox>
    </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
      <Button x:Name="CloseBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="96" IsCancel="True" Content="OK"/>
    </Border>
  </Grid>
</Window>

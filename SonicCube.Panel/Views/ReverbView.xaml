<UserControl x:Class="SonicCube.Panel.Views.ReverbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="136">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 标题徽章 -->
        <RowDefinition Height="Auto"/>   <!-- 算法下拉 -->
        <RowDefinition Height="*"/>      <!-- 参数旋钮 -->
      </Grid.RowDefinitions>
      <TextBlock x:Name="Title" Grid.Row="0" Style="{StaticResource TitleText}" TextAlignment="Left" Margin="0,4,0,12"/>
      <ComboBox x:Name="AlgSelect" Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource MixerCombo}"
                ItemContainerStyle="{StaticResource MixerComboItem}"/>
      <Grid x:Name="KnobHost" Grid.Row="2" VerticalAlignment="Center"/>
      <Border x:Name="Mask" Grid.Row="1" Grid.RowSpan="2" Background="#D9282828" CornerRadius="4" Visibility="Collapsed" Panel.ZIndex="10">
        <Border Background="{StaticResource BrushControl}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="1" CornerRadius="4"
                Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="BYPASS" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextSecondary}"/>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="SonicCube.Panel.Views.ReverbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="136">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 标题徽章 -->
        <RowDefinition Height="Auto"/>   <!-- 算法下拉 -->
        <RowDefinition Height="*"/>      <!-- 参数旋钮 -->
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource ChannelHeaderBadge}" Margin="0,0,0,6">
        <TextBlock x:Name="Title" Style="{StaticResource TitleText}"/>
      </Border>
      <ComboBox x:Name="AlgSelect" Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource MixerCombo}"
                ItemContainerStyle="{StaticResource MixerComboItem}"/>
      <Border Grid.Row="2" Style="{StaticResource InsetWellBorder}" Padding="4">
        <Grid x:Name="KnobHost" VerticalAlignment="Center"/>
      </Border>
      <Border x:Name="Mask" Grid.RowSpan="3" Background="#B816161A" CornerRadius="6" Visibility="Collapsed" Panel.ZIndex="10">
        <Border Background="#26FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="4"
                Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="BYPASS" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextSecondary}"/>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>

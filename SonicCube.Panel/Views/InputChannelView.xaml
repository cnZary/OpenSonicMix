<UserControl x:Class="SonicCube.Panel.Views.InputChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="150">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 0: 模块按钮 2×2 -->
        <RowDefinition Height="Auto"/>   <!-- 1: 反相 -->
        <RowDefinition Height="Auto"/>   <!-- 2: 分隔线 -->
        <RowDefinition Height="Auto"/>   <!-- 3: SEND 旋钮 -->
        <RowDefinition Height="Auto"/>   <!-- 4: 发送量标签 -->
        <RowDefinition Height="Auto"/>   <!-- 5: 声像 -->
        <RowDefinition Height="Auto"/>   <!-- 6: 通道名称徽章 -->
        <RowDefinition Height="*"/>      <!-- 7: 推子 + M/S + 电平 -->
        <RowDefinition Height="Auto"/>   <!-- 8: 推子数值胶囊 -->
      </Grid.RowDefinitions>

      <!-- 功能按钮 -->
      <Grid Grid.Row="0" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ToggleButton x:Name="BtnComp" Grid.Row="0" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,0,2.5,2.5"/>
        <ToggleButton x:Name="BtnEq"   Grid.Row="0" Grid.Column="1" Style="{StaticResource ChannelToggle}" Margin="2.5,0,0,2.5"/>
        <!-- MIC1: HPF + 48V 两列;CH2: HPF 横跨 -->
        <ToggleButton x:Name="BtnHpf"  Grid.Row="1" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,2.5,2.5,0"/>
        <ToggleButton x:Name="Btn48V"  Grid.Row="1" Grid.Column="1" Style="{StaticResource WarnToggle}" Margin="2.5,2.5,0,0"/>
      </Grid>

      <!-- 反相(居中) -->
      <ToggleButton x:Name="BtnPhase" Grid.Row="1" Style="{StaticResource ChannelToggle}"
                    Width="48" Height="22" HorizontalAlignment="Center" Margin="0,2,0,4"/>

      <!-- Fluent 2 细分隔线 -->
      <Border Grid.Row="2" Height="1" Background="{StaticResource BrushDivider}" Margin="4,2,4,4"/>

      <!-- SEND 旋钮 -->
      <c:KnobControl x:Name="SendKnob" Grid.Row="3" Width="66" Height="82" HorizontalAlignment="Center"/>
      <TextBlock x:Name="SendLabel" Grid.Row="4" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

      <!-- 声像(内嵌槽包裹) -->
      <Border Grid.Row="5" Style="{StaticResource InsetWellBorder}" Padding="6,3,6,4" Margin="0,0,0,6">
        <c:PanSliderControl x:Name="Pan"/>
      </Border>

      <!-- 通道名称徽章 -->
      <Border Grid.Row="6" Style="{StaticResource ChannelHeaderBadge}" Margin="0,0,0,6">
        <TextBlock x:Name="Title" Style="{StaticResource TitleText}"/>
      </Border>

      <!-- 推子 + M/S + 电平 -->
      <Grid Grid.Row="7" Margin="0,0,0,6" MinHeight="200">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <c:VolumeFaderControl x:Name="Fader" Grid.Column="0" HorizontalAlignment="Center" Width="52"/>
        <Grid Grid.Column="1" Width="50" Margin="4,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ToggleButton x:Name="BtnMute" Grid.Row="0" Style="{StaticResource MuteToggle}" Margin="0,0,0,4"/>
          <ToggleButton x:Name="BtnSolo" Grid.Row="1" Style="{StaticResource WarnToggle}" Margin="0,0,0,6"/>
          <Border Grid.Row="2" Style="{StaticResource InsetWellBorder}" Padding="4,4,3,4">
            <c:MeterBar x:Name="Meter" Width="38" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Grid>

      <!-- 推子数值胶囊 -->
      <Border Grid.Row="8" Style="{StaticResource ReadoutPill}">
        <TextBlock x:Name="FaderValue" Style="{StaticResource ValueText}"/>
      </Border>
    </Grid>
  </Border>
</UserControl>

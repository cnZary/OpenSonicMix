<UserControl x:Class="SonicCube.Panel.Views.InputChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="168">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 通道标题 -->
        <RowDefinition Height="Auto"/>   <!-- 模块按钮 2×2 -->
        <RowDefinition Height="Auto"/>   <!-- 反相 -->
        <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
        <RowDefinition Height="Auto"/>   <!-- SEND 旋钮与标签 -->
        <RowDefinition Height="Auto"/>   <!-- 声像 -->
        <RowDefinition Height="*"/>      <!-- 对齐的推子与电平 -->
        <RowDefinition Height="Auto"/>   <!-- MUTE / SOLO -->
        <RowDefinition Height="Auto"/>   <!-- 推子读数 -->
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ChannelHeaderBadge}" MinHeight="32" Margin="0,0,0,12">
        <TextBlock x:Name="Title" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
      </Border>

      <!-- 功能按钮 -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ToggleButton x:Name="BtnComp" Grid.Row="0" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,0,4,4"/>
        <ToggleButton x:Name="BtnEq"   Grid.Row="0" Grid.Column="1" Style="{StaticResource ChannelToggle}" Margin="0,0,0,4"/>
        <!-- MIC1: HPF + 48V 两列;CH2: HPF 横跨 -->
        <ToggleButton x:Name="BtnHpf"  Grid.Row="1" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,0,4,0"/>
        <ToggleButton x:Name="Btn48V"  Grid.Row="1" Grid.Column="1" Style="{StaticResource WarnToggle}"/>
      </Grid>

      <!-- 反相(居中) -->
      <ToggleButton x:Name="BtnPhase" Grid.Row="2" Style="{StaticResource ChannelToggle}"
                    Width="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <!-- Fluent 2 细分隔线 -->
      <Border Grid.Row="3" Height="1" Background="{StaticResource BrushDivider}" Margin="0,0,0,8"/>

      <!-- SEND 旋钮 -->
      <Grid Grid.Row="4" Margin="0,0,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <c:KnobControl x:Name="SendKnob" Width="68" Height="84" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SendLabel" Grid.Row="1" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
      </Grid>

      <!-- 声像(内嵌槽包裹) -->
      <Border Grid.Row="5" Style="{StaticResource InsetWellBorder}" Padding="8,4" Margin="0,0,0,12">
        <c:PanSliderControl x:Name="Pan"/>
      </Border>

      <!-- 推子与电平槽共用上下边界,状态按钮固定在下方 -->
      <Grid Grid.Row="6" Margin="0,0,0,12" MinHeight="180">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="54"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <c:VolumeFaderControl x:Name="Fader" Grid.Column="1" Width="52"/>
        <Border Grid.Column="3" Style="{StaticResource InsetWellBorder}" Padding="6,4">
          <c:MeterBar x:Name="Meter" Width="38" HorizontalAlignment="Center"/>
        </Border>
      </Grid>

      <Grid Grid.Row="7" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ToggleButton x:Name="BtnMute" Grid.Column="0" Style="{StaticResource MuteToggle}"/>
        <ToggleButton x:Name="BtnSolo" Grid.Column="2" Style="{StaticResource WarnToggle}"/>
      </Grid>

      <!-- 推子数值胶囊 -->
      <Border Grid.Row="8" Style="{StaticResource ReadoutPill}" MinHeight="28">
        <TextBlock x:Name="FaderValue" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</UserControl>

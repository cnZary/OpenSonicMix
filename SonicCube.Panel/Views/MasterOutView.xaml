<UserControl x:Class="SonicCube.Panel.Views.MasterOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="160">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>     <!-- Logo 区域(暂时留空) -->
        <RowDefinition Height="*"/>      <!-- 主输出电平 -->
        <RowDefinition Height="Auto"/>   <!-- 刻度 -->
        <RowDefinition Height="Auto"/>   <!-- 左/右 -->
        <RowDefinition Height="Auto"/>   <!-- 效果录入/原声录入 -->
        <RowDefinition Height="Auto"/>   <!-- 总静音 -->
        <RowDefinition Height="Auto"/>   <!-- 单声道混合 -->
      </Grid.RowDefinitions>

      <!-- Logo 区域:完全留空,不放图片/图标/文字,保持高度与位置 -->
      <Border Grid.Row="0"/>

      <!-- 主输出电平(视觉中心,明显高于通道电平;右侧自带 dB 刻度尺) -->
      <c:MeterBar x:Name="Meter" Grid.Row="1" Width="52" HorizontalAlignment="Center" Margin="0,4"/>

      <!-- 刻度行:电平表自带 dB 刻度,此处不再单独呈现 -->
      <TextBlock x:Name="Scale" Grid.Row="2" Style="{StaticResource LabelText}" Text=""/>

      <!-- 左 / 右 -->
      <Grid Grid.Row="3" Margin="0,2,0,4">
        <TextBlock Style="{StaticResource LabelText}" Text="L" HorizontalAlignment="Left" Margin="30,0,0,0"/>
        <TextBlock Style="{StaticResource LabelText}" Text="R" HorizontalAlignment="Right" Margin="0,0,30,0"/>
      </Grid>

      <!-- 效果录入 / 原声录入(分段选择) -->
      <Grid Grid.Row="4" Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ToggleButton x:Name="BtnDspRec" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,0,2,0"/>
        <ToggleButton x:Name="BtnDspMon" Grid.Column="1" Style="{StaticResource ChannelToggle}" Margin="2,0,0,0"/>
      </Grid>

      <ToggleButton x:Name="BtnMasterMute" Grid.Row="5" Style="{StaticResource ChannelToggle}" Margin="0,2"/>
      <ToggleButton x:Name="BtnMono" Grid.Row="6" Style="{StaticResource ChannelToggle}" Margin="0,2"/>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="SonicCube.Panel.Views.MasterOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="168">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 总线标题 -->
        <RowDefinition Height="*"/>      <!-- 主输出电平 -->
        <RowDefinition Height="Auto"/>   <!-- 刻度 -->
        <RowDefinition Height="Auto"/>   <!-- 左/右 -->
        <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
        <RowDefinition Height="Auto"/>   <!-- 效果录入/原声录入 -->
        <RowDefinition Height="Auto"/>   <!-- 总静音 -->
        <RowDefinition Height="Auto"/>   <!-- 单声道混合 -->
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ChannelHeaderBadge}" MinHeight="32" Margin="0,0,0,12">
        <TextBlock x:Name="MasterTitle" Style="{StaticResource TitleText}" Text="MASTER" VerticalAlignment="Center"/>
      </Border>

      <!-- 主输出电平(视觉中心,内嵌深色槽包裹;右侧自带 dB 刻度尺) -->
      <Border Grid.Row="1" Style="{StaticResource InsetWellBorder}" HorizontalAlignment="Center" Padding="12,8" MinHeight="180">
        <c:MeterBar x:Name="Meter" Width="58" HorizontalAlignment="Center"/>
      </Border>

      <!-- 刻度行:电平表自带 dB 刻度,此处不再单独呈现 -->
      <TextBlock x:Name="Scale" Grid.Row="2" Style="{StaticResource LabelText}" Visibility="Collapsed"/>

      <!-- 左 / 右 声道标识 -->
      <Grid Grid.Row="3" Width="40" HorizontalAlignment="Center" Margin="0,8,20,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource SectionCaptionText}" Text="L"/>
        <TextBlock Grid.Column="1" Style="{StaticResource SectionCaptionText}" Text="R"/>
      </Grid>

      <Border Grid.Row="4" Height="1" Background="{StaticResource BrushDivider}" Margin="0,0,0,12"/>

      <!-- 效果录入 / 原声录入(分段选择槽) -->
      <Border Grid.Row="5" Style="{StaticResource InsetWellBorder}" Padding="4" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="BtnDspRec" Grid.Column="0" Style="{StaticResource ChannelToggle}" Margin="0,0,4,0"/>
          <ToggleButton x:Name="BtnDspMon" Grid.Column="1" Style="{StaticResource ChannelToggle}"/>
        </Grid>
      </Border>

      <ToggleButton x:Name="BtnMasterMute" Grid.Row="6" Style="{StaticResource MuteToggle}" Margin="0,0,0,8"/>
      <ToggleButton x:Name="BtnMono" Grid.Row="7" Style="{StaticResource ChannelToggle}"/>
    </Grid>
  </Border>
</UserControl>

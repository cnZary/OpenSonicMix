<UserControl x:Class="SonicCube.Panel.Views.AlgorithmEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 算法下拉 -->
      <RowDefinition Height="*"/>      <!-- 参数旋钮区 -->
    </Grid.RowDefinitions>
    <ComboBox x:Name="AlgSelect" Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource MixerCombo}"
              ItemContainerStyle="{StaticResource MixerComboItem}"/>
    <Border Grid.Row="1" Background="#12FFFFFF" BorderBrush="#14FFFFFF"
            BorderThickness="1" CornerRadius="6" Padding="6,6,6,4">
      <Grid x:Name="KnobHost"/>
    </Border>
    <!-- 模块未使能遮罩 -->
    <Border x:Name="Mask" Grid.RowSpan="2" Background="#B816161A" CornerRadius="6" Visibility="Collapsed" Panel.ZIndex="10">
      <Border Background="#26FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="4"
              Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="BYPASS" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextSecondary}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>

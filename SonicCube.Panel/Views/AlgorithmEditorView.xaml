<UserControl x:Class="SonicCube.Panel.Views.AlgorithmEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 算法下拉 -->
      <RowDefinition Height="*"/>      <!-- 参数旋钮区 -->
    </Grid.RowDefinitions>
    <ComboBox x:Name="AlgSelect" Grid.Row="0" Margin="0,2,0,6" Style="{StaticResource MixerCombo}"
              ItemContainerStyle="{StaticResource MixerComboItem}"/>
    <Border Grid.Row="1" Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1" CornerRadius="4" Padding="4">
      <Grid x:Name="KnobHost"/>
    </Border>
    <!-- 模块未使能遮罩 -->
    <Border x:Name="Mask" Grid.RowSpan="2" Background="#AA141418" Visibility="Collapsed" Panel.ZIndex="10"/>
  </Grid>
</UserControl>

<UserControl x:Class="SonicCube.Panel.Views.AlgorithmEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 算法下拉 -->
      <RowDefinition Height="*"/>      <!-- 参数编辑区 -->
    </Grid.RowDefinitions>
    <ComboBox x:Name="AlgSelect" Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource MixerCombo}"
              ItemContainerStyle="{StaticResource MixerComboItem}"/>
    <Border Grid.Row="1" Margin="0,4,0,0">
      <Grid x:Name="KnobHost"/>
    </Border>
    <!-- 模块未使能遮罩 -->
    <Border x:Name="Mask" Grid.RowSpan="2" Background="#D9202020" CornerRadius="4" Visibility="Collapsed" Panel.ZIndex="10">
      <Border Background="{StaticResource BrushControl}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="1" CornerRadius="4"
              Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="BYPASS" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextSecondary}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>

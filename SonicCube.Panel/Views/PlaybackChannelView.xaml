<UserControl x:Class="SonicCube.Panel.Views.PlaybackChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls"
             MinWidth="124">
  <Border Style="{StaticResource ChannelCard}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 0: 内录/路由 -->
        <RowDefinition Height="Auto"/>   <!-- 1: 通道名称徽章 -->
        <RowDefinition Height="*"/>      <!-- 2: 推子 + M + 电平 -->
        <RowDefinition Height="Auto"/>   <!-- 3: 数值胶囊 -->
      </Grid.RowDefinitions>

      <ToggleButton x:Name="BtnLoopback" Grid.Row="0" Style="{StaticResource ChannelToggle}" Margin="0,0,0,6"/>

      <Border Grid.Row="1" Style="{StaticResource ChannelHeaderBadge}" Margin="0,0,0,6">
        <TextBlock x:Name="Title" Style="{StaticResource TitleText}"/>
      </Border>

      <Grid Grid.Row="2" MinHeight="150" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <c:VolumeFaderControl x:Name="Fader" Grid.Column="0" HorizontalAlignment="Center" Width="50"/>
        <Grid Grid.Column="1" Width="46" Margin="4,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ToggleButton x:Name="BtnMute" Grid.Row="0" Style="{StaticResource MuteToggle}" Margin="0,0,0,6"/>
          <Border Grid.Row="1" Style="{StaticResource InsetWellBorder}" Padding="4,4,3,4">
            <c:MeterBar x:Name="Meter" Width="36" HorizontalAlignment="Center"/>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource ReadoutPill}">
        <TextBlock x:Name="FaderValue" Style="{StaticResource ValueText}"/>
      </Border>
    </Grid>
  </Border>
</UserControl>

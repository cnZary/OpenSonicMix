<UserControl x:Class="SonicCube.Panel.Views.GlobalEqEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource BrushMeterTrack}"
            CornerRadius="4" ClipToBounds="True">
      <c:GraphicEqControl x:Name="Eq"/>
    </Border>
    <!-- 右侧总音量(UI -50~+50 ↔ 协议 0~100) -->
    <Border Grid.Column="1" Padding="4,0" Width="64" Margin="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="VolLabel" Style="{StaticResource SectionCaptionText}" Text="VOL" Margin="0,0,0,4"/>
        <c:LinearFaderControl x:Name="Vol" Grid.Row="1" Width="40" MinHeight="80" MaxHeight="118" HorizontalAlignment="Center"/>
        <Border Grid.Row="2" Style="{StaticResource ReadoutPill}" Margin="0,4,0,0">
          <TextBlock x:Name="VolValue" Style="{StaticResource ValueText}"/>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="Mask" Grid.ColumnSpan="2" Background="#D9202020" CornerRadius="4" Visibility="Collapsed" Panel.ZIndex="10">
      <Border Background="{StaticResource BrushControl}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="1" CornerRadius="4"
              Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="BYPASS" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushTextSecondary}"/>
      </Border>
    </Border>
  </Grid>
</UserControl>

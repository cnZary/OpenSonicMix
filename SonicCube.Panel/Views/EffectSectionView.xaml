<UserControl x:Class="SonicCube.Panel.Views.EffectSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SonicCube.Panel.Controls">
  <Border Style="{StaticResource ChannelCard}" Padding="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- 页签 + 重置 -->
        <RowDefinition Height="Auto"/>   <!-- 模块选择 + 编辑区(不拉伸) -->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <StackPanel x:Name="TabHost" Orientation="Horizontal"/>
          <Button x:Name="FullResetBtn" Style="{StaticResource DangerButton}" Padding="10,0"
                  Margin="8,0,0,0" VerticalAlignment="Center" Content="Reset All"/>
        </StackPanel>
        <Button x:Name="ResetBtn" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                Padding="10,0" Content="Reset"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 窄模块选择列:与右侧编辑区边框同高对齐 -->
        <Border Grid.Column="0" Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,6,0">
          <StackPanel x:Name="ModuleList" VerticalAlignment="Center"/>
        </Border>
        <!-- 当前模块编辑区 -->
        <Border Grid.Column="1" Background="{StaticResource BrushPanelDeep}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="4" Padding="6" VerticalAlignment="Top">
          <ContentControl x:Name="EditorHost"/>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>

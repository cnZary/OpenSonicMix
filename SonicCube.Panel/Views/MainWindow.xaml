<Window x:Class="SonicCube.Panel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SonicCube.Panel.Views"
        Title="SonicCubePanel"
        Width="1240" Height="940"
        MinWidth="1120" MinHeight="840"
        Background="{StaticResource BrushWindow}"
        Foreground="{StaticResource BrushText}"
        FontFamily="{StaticResource FontPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>      <!-- 主工作区 -->
      <RowDefinition Height="Auto"/>   <!-- 底部全局控制条 -->
    </Grid.RowDefinitions>

    <!-- 主工作区 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="164"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="164"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="468"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="184"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="Mic1Host" Grid.Column="0"/>
      <Border x:Name="Line2Host" Grid.Column="2"/>

      <!-- 中央:上方效果编辑,下方回放+混响 -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="286"/>
          <RowDefinition Height="*" MinHeight="296"/>
        </Grid.RowDefinitions>
        <v:EffectSectionView x:Name="Fx" Grid.Row="0" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="164"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="164"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="168"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="UsbHost" Grid.Column="0"/>
          <Border x:Name="OtgHost" Grid.Column="2"/>
          <v:ReverbView x:Name="Rvb" Grid.Column="4"/>
        </Grid>
      </Grid>

      <v:MasterOutView x:Name="Master" Grid.Column="6"/>
    </Grid>

    <!-- 底部全局控制条 -->
    <v:BottomBarView x:Name="BottomBar" Grid.Row="1" Margin="0,12,0,0"/>
  </Grid>
</Window>
